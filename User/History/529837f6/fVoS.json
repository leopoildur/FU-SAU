{
    "files.associations": {
        "renv.lock": "json"
    },
    "positron.assistant.enable": true,
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.editorAssociations": {
        "*.xlsx": "default"
    },
    "workbench.colorTheme": "Monokai Pro (Filter Octagon)",
    "editor.fontSize": 16,
    "editor.fontFamily": "JetBrains Mono",
